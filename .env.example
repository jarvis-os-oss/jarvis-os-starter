# JARVIS-OS Starter Kit: environment template.
# Copy to .env and fill in real values. NEVER commit the resulting .env.
# scripts/setup.py can generate this file interactively.

# --- Instance identity ------------------------------------------------------
AIOS_INSTANCE_NAME=JARVIS-OS
AIOS_HOME=/opt/aios

# --- Cockpit ----------------------------------------------------------------
# Access token for the cockpit UI/API. Generate a long random value.
# Example only, DO NOT use this literal value:
COCKPIT_TOKEN=change-me-to-a-long-random-token
COCKPIT_PORT=8517

# Optional public hostname if you serve the cockpit behind a reverse proxy.
COCKPIT_PUBLIC_DOMAIN=cockpit.example.com

# --- Agent gateways ---------------------------------------------------------
# Bearer key the cockpit uses to call the JARVIS gateway (Hermes API server).
API_SERVER_KEY=change-me-agent-server-key
JARVIS_API_URL=http://127.0.0.1:8642/v1/chat/completions

# Space-separated Hermes profiles the watchdog keeps always-on.
# Ships with only "default" (JARVIS) so a fresh install works out of the box.
# Create the base sub-agents with scripts/create_agent_profiles.sh, then extend:
#   AIOS_AGENTS=default assistant scout ada scotty pen
AIOS_AGENTS=default

# --- LLM provider (used by the Hermes runtime, not by this repo directly) ----
# Put your provider key here. Placeholder only:
LLM_API_KEY=sk-your-provider-key-here
